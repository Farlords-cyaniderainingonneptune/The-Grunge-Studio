
{
  "defaultEnv": { "ENV": "NODE_ENV" },
  "development": {
    "driver": "pg",
    "connectionString": { "ENV": "DATABASE_URL" }
  },
  "test": {
    "driver": "pg",
    "connectionString": { "ENV": "TEST_DATABASE_URL" }
  },
